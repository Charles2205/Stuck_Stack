# SQLite for local dev. For Vercel + Neon/Supabase, switch prisma/schema.prisma
# provider to "postgresql" and set this to your pooled Postgres URL.
DATABASE_URL="file:./dev.db"

# Signs the organizer session cookie. A dev fallback is baked in, but set a
# real random secret in production (e.g. `openssl rand -base64 32`).
# SESSION_SECRET="change-me"
