// Stuck Stack data model.
// Postgres (Neon via Vercel Marketplace) for dev and prod; DATABASE_URL comes
// from `vercel env pull .env` (see docs/ARCHITECTURE.md §3).
// Status/role fields are String (not enum) — a relic of the SQLite dev phase,
// kept for simplicity; values are constrained in lib/constants.ts and
// validated with Zod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Neon) — runtime queries
  directUrl = env("DATABASE_URL_UNPOOLED") // direct — migrations
}

model Organizer {
  id        String   @id @default(cuid())
  name      String
  // Lowercased copy of name enforcing case-insensitive uniqueness (SQLite has
  // no citext/insensitive mode in Prisma; same columns work on Postgres).
  nameKey   String   @unique
  createdAt DateTime @default(now())
  events    Event[]
}

model Event {
  id          String     @id @default(cuid())
  organizerId String
  name        String
  slug        String     @unique
  date        DateTime
  createdAt   DateTime   @default(now())
  organizer   Organizer  @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  attendees   Attendee[]
  blockers    Blocker[]

  @@index([organizerId])
}

model Attendee {
  id         String      @id @default(cuid())
  eventId    String
  name       String
  role       String      @default("ATTENDEE") // ATTENDEE | ORGANISER
  createdAt  DateTime    @default(now())
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  blockers   Blocker[]   @relation("AuthoredBlockers")
  stuckToos  StuckToo[]
  helpOffers HelpOffer[]

  @@index([eventId])
}

model Blocker {
  id          String      @id @default(cuid())
  eventId     String
  authorId    String
  title       String
  description String
  status      String      @default("OPEN") // OPEN | MATCHED | SOLVED
  createdAt   DateTime    @default(now())
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author      Attendee    @relation("AuthoredBlockers", fields: [authorId], references: [id], onDelete: Cascade)
  tags        Tag[]
  stuckToos   StuckToo[]
  helpOffers  HelpOffer[]

  @@index([eventId, status])
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  blockers Blocker[]
}

model StuckToo {
  id         String   @id @default(cuid())
  blockerId  String
  attendeeId String
  createdAt  DateTime @default(now())
  blocker    Blocker  @relation(fields: [blockerId], references: [id], onDelete: Cascade)
  attendee   Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([blockerId, attendeeId])
}

model HelpOffer {
  id        String    @id @default(cuid())
  blockerId String
  helperId  String
  status    String    @default("OFFERED") // OFFERED | CLAIMED | COMPLETED
  createdAt DateTime  @default(now())
  blocker   Blocker   @relation(fields: [blockerId], references: [id], onDelete: Cascade)
  helper    Attendee  @relation(fields: [helperId], references: [id], onDelete: Cascade)
  helpSlot  HelpSlot?

  @@unique([blockerId, helperId])
}

model HelpSlot {
  id              String    @id @default(cuid())
  helpOfferId     String    @unique
  startTime       DateTime
  location        String
  durationMinutes Int       @default(5)
  helpOffer       HelpOffer @relation(fields: [helpOfferId], references: [id], onDelete: Cascade)
}
